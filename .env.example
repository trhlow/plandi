# Chép thành .env (đã gitignore) cho staging/production. Máy dev dùng profile local, không cần file này.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/plandi
SPRING_DATASOURCE_USERNAME=plandi
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_HOST=redis
# 32 byte ngẫu nhiên, base64: openssl rand -base64 32
PLANDI_DATA_KEY=
GOOGLE_MAPS_API_KEY=
TMDB_API_TOKEN=
